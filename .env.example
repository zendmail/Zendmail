# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://user:password@localhost:5432/zendmail
APP_URL=http://localhost:3000
CRON_SECRET=change-me

# Email (leave EMAIL_PROVIDER_API_KEY empty to just print emails in the terminal)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Zendmail <onboarding@resend.dev>
# Platform-owned domains: addresses here send via EMAIL_FROM, never as-is. Workspace domains are verified under Settings → Sending Domains instead.
EMAIL_VERIFIED_DOMAINS=
# Resend webhook signing secret (whsec_...). Point Resend at /api/webhooks/resend for delivered/bounced/complained events.
RESEND_WEBHOOK_SECRET=

# Store integrations (Shopify + WooCommerce). Both Shopify OAuth AND the encryption key are required to connect a store.
# AES-256-GCM key for stored store credentials. Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes. Changing it later makes existing store connections unreadable.
STORE_CREDENTIALS_ENCRYPTION_KEY=
# From your Shopify Dev Dashboard app (Client ID / Client secret).
# Redirect URL to register: {APP_URL}/api/integrations/shopify/callback
# Webhook: {APP_URL}/api/webhooks/shopify/app-uninstalled
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Optional, only after Shopify approves it, e.g. read_all_orders
SHOPIFY_EXTRA_SCOPES=
