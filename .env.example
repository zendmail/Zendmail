# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://user:password@localhost:5432/zendmail
APP_URL=http://localhost:3000
CRON_SECRET=change-me

# Email (leave EMAIL_PROVIDER_API_KEY empty to just print emails in the terminal)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Zendmail <onboarding@resend.dev>
# Platform-owned domains: addresses here send via EMAIL_FROM, never as-is. Workspace domains are verified under Settings → Sending Domains instead.
EMAIL_VERIFIED_DOMAINS=
# Resend webhook signing secret (whsec_...). Point Resend at /api/webhooks/resend for delivered/bounced/complained events.
RESEND_WEBHOOK_SECRET=
