# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://user:password@localhost:5432/zendmail
APP_URL=http://localhost:3000
CRON_SECRET=change-me

# Email (leave EMAIL_PROVIDER_API_KEY empty to just print emails in the terminal)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Zendmail <onboarding@resend.dev>
EMAIL_VERIFIED_DOMAINS=

# Sending domains page: managing domains needs a FULL-ACCESS Resend key.
# Optional - keeps EMAIL_PROVIDER_API_KEY a low-privilege "sending access" key. If unset, the sending key is used.
EMAIL_DOMAINS_API_KEY=
